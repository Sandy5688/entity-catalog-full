# ============================
# Database
# ============================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=entity_catalog
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# ============================
# JWT / Auth
# ============================
JWT_SECRET=your_jwt_secret
API_KEY=your_api_key_here

# ============================
# Redis / Cache
# ============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ============================
# App Environment
# ============================
NODE_ENV=development
PORT=3000

# ============================
# Metrics
# ============================
METRICS_PORT=9090
